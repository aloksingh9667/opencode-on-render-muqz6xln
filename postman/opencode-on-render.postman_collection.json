{
  "info": {
    "_postman_id": "opencode-on-render-collection",
    "name": "OpenCode on Render",
    "description": "Chat with your hosted OpenCode agent. Set the `password` collection variable to your Render OPENCODE_SERVER_PASSWORD first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{username}}", "type": "string" },
      { "key": "password", "value": "{{password}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://opencode-on-render-muqz6xln.onrender.com" },
    { "key": "username", "value": "opencode" },
    { "key": "password", "value": "PASTE_RENDER_PASSWORD_HERE" },
    { "key": "sessionId", "value": "" }
  ],
  "item": [
    {
      "name": "1 - Health check",
      "request": { "method": "GET", "url": "{{baseUrl}}/global/health" }
    },
    {
      "name": "2 - Create session (saves id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var json = pm.response.json();",
              "if (json && json.id) { pm.collectionVariables.set(\"sessionId\", json.id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/session",
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"First chat\"\n}" }
      }
    },
    {
      "name": "3 - Send message (waits for reply)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/session/{{sessionId}}/message",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"parts\": [\n    { \"type\": \"text\", \"text\": \"Hello, what can you do?\" }\n  ]\n}"
        }
      }
    },
    {
      "name": "4 - List messages",
      "request": { "method": "GET", "url": "{{baseUrl}}/session/{{sessionId}}/message?limit=20" }
    },
    {
      "name": "5 - List sessions",
      "request": { "method": "GET", "url": "{{baseUrl}}/session" }
    },
    {
      "name": "6 - Send async (no wait)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/session/{{sessionId}}/prompt_async",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"parts\": [\n    { \"type\": \"text\", \"text\": \"Explain async await in JavaScript\" }\n  ]\n}"
        }
      }
    },
    {
      "name": "7 - Abort session",
      "request": { "method": "POST", "url": "{{baseUrl}}/session/{{sessionId}}/abort" }
    },
    {
      "name": "8 - Delete session",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/session/{{sessionId}}" }
    }
  ]
}
